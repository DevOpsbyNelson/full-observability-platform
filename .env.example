# Copy to .env and fill in. .env is git-ignored.

# Grafana
GF_SERVER_ROOT_URL=http://localhost:3000
GF_AUTH_DISABLE_LOGIN_FORM=false
GF_SECURITY_ADMIN_USER=admin

# GitHub OAuth (https://github.com/settings/developers).
# Callback URL: <GF_SERVER_ROOT_URL>/login/github
GF_AUTH_GITHUB_CLIENT_ID=
GF_AUTH_GITHUB_CLIENT_SECRET=
GF_AUTH_GITHUB_ORG=
GF_SECURITY_ADMIN_PASSWORD=
GF_AUTH_DISABLE_LOGIN_FORM=true

# Service
NODE_ENV=production
SERVICE_NAME=service
# V8 old-space (heap) limit in MiB. Keep it below the container memory limit.
NODE_OPTIONS="--max-old-space-size=3072"

# OpenTelemetry (service -> Alloy). Metrics are scraped from :9464/metrics instead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318

# Alloy
ALLOY_TEMPO_OTLP_ENDPOINT=http://tempo:4318
ALLOY_LOKI_URL=http://loki:3100/loki/api/v1/push
# % of normal (non-error, non-slow) traces to keep; lower it in prod.
ALLOY_SAMPLE_RATE=100

# Prometheus (rendered into prometheus.template.yml by entrypoint.sh)
PROMETHEUS_EXPORTER_TARGET=localhost:9090
PROMETHEUS_ALERT_MANAGER_TARGET=alertmanager:9093
SERVICE_ENABLED=true
SERVICE_EXPORTER_TARGET=service:9464

# Tempo (tempo.yaml, expanded with -config.expand-env)
TEMPO_PROMETHEUS_REMOTE_WRITE_URL=http://prometheus:9090/api/v1/write

# Alertmanager (rendered into alertmanager.template.yml by entrypoint.sh)
# Incoming webhook: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
SLACK_ALERTS_CHANNEL=#alerts
